# ---------------------------------------------------------------------------
# CINEBOOK environment configuration
# Copy to .env and change every value marked CHANGE_ME before deploying:
#     cp .env.example .env
# ---------------------------------------------------------------------------

# Host port Nginx listens on (http://localhost when 80)
HTTP_PORT=80

# PostgreSQL
POSTGRES_USER=cinebook
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=cinebook
POSTGRES_HOST=db
POSTGRES_PORT=5432

# JWT – generate with:  openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32_chars_min
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Administrator account created on first start
ADMIN_EMAIL=admin@cinebook.local
ADMIN_PASSWORD=CHANGE_ME_Admin123
ADMIN_NAME=CINEBOOK Administrator

# Load the starter catalogue (movies, theatres, screens, a week of showtimes)
SEED_SAMPLE_DATA=true
APP_TIMEZONE=Asia/Kolkata

# Booking rules
CONVENIENCE_FEE_PER_TICKET=30
MAX_SEATS_PER_BOOKING=10
CANCELLATION_CUTOFF_HOURS=2
FULL_REFUND_HOURS=24
PARTIAL_REFUND_PERCENT=50

CORS_ORIGINS=http://localhost
UVICORN_WORKERS=2
